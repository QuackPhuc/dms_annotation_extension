{
  "manifest_version": 3,
  "name": "NOTA Labeling Organizer",
  "version": "1.6.8",
  "description": "Gom frame theo clip; phím tắt body/hand/eye, chỉnh cạnh body và thao tác nhãn hàng loạt bằng Ctrl+B.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NOTA Labeling Organizer",
    "default_popup": "popup.html"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ntt.dev.nota.ai/*",
        "http://10.169.1.102:8765/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
